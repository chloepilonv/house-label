{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run data/artist/brief/hook.ts",
            "timeout": 15,
            "statusMessage": "Reading the artist's file\u2026"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ]
  }
}
