{
  "name": "house-label",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source agentic music label.",
  "author": "Chloe Bibiane Pilon Vaillancourt",
  "type": "module",
  "scripts": {
    "dev:up": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "dev:setup": "bun run artist:migrate",
    "houselabel": "bun run engine/cli.ts",
    "houselabel:init": "bun run engine/cli.ts init",
    "houselabel:profile": "bun run engine/cli.ts profile",
    "houselabel:voice": "bun run engine/cli.ts voice",
    "houselabel:recap": "bun run engine/cli.ts recap",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc",
    "models:check": "bun run engine/model-check.ts",
    "agents:sync": "bun run agents/sync.ts",
    "agents:check": "bun run agents/sync.ts --check",
    "test": "bun test",
    "evals:run": "bun run agents/agent-recruitor/skills/recruit-evaluate/scripts/run-evals.ts",
    "evals:reset": "docker compose exec db psql -U postgres -d postgres -c 'drop database if exists music_label_evals' -c 'create database music_label_evals'",
    "artist:migrate": "bun run data/artist/migrate.ts",
    "artist:brief": "bun run data/artist/brief/cli.ts brief",
    "artist:get": "bun run data/artist/brief/cli.ts get",
    "artist:set": "bun run data/artist/brief/cli.ts set",
    "artist:remember": "bun run data/artist/brief/cli.ts remember",
    "artist:fixture": "bun run data/artist/fixtures/load.ts",
    "artist:psql": "sh -c 'db=${DATABASE_URL##*/}; db=${db%%\\?*}; docker compose exec db psql -U postgres -d \"${db:-music_label_artist}\" \"$@\"' --",
    "artist:reset": "docker compose exec db psql -U postgres -d postgres -c 'drop database if exists music_label_artist' -c 'create database music_label_artist'",
    "catalog:migrate": "bun run data/catalog/migrate.ts",
    "catalog:refresh": "bun run data/catalog/crawl/run.ts",
    "catalog:sources": "bun run data/catalog/crawl/sources.ts",
    "catalog:report": "bun run data/catalog/crawl/report.ts",
    "catalog:enrich:distribution": "bun run data/catalog/distribution/enrich.ts",
    "catalog:help-centres": "bun run data/catalog/distribution/help-centres.ts",
    "catalog:load": "bun run data/catalog/publish/load.ts",
    "catalog:build": "bun run data/catalog/publish/build.ts",
    "catalog:sql": "bun -e 'console.log(require(\"bun:sqlite\").Database.open(\"data/catalog/catalog.sqlite\").query(process.argv[1]).all())'",
    "catalog:reset": "docker compose exec db psql -U postgres -d postgres -c 'drop database if exists music_label_catalog' -c 'create database music_label_catalog'",
    "catalog:privacy": "bun run data/catalog/privacy/check.ts",
    "catalog:setup": "bun run catalog:load",
    "presskit:e2e": "bun run agents/presskit/evals/e2e.ts",
    "evals:converse": "bun run evals/converse.ts",
    "social:variants": "bun run agents/digital-marketing/skills/digital-marketing-draft-content/scripts/variants.ts",
    "presskit:print": "bun run agents/presskit/skills/presskit-build/scripts/print.ts",
    "website:build": "bun run agents/digital-marketing/skills/digital-marketing-build-website/scripts/build.ts",
    "website:deploy": "bun run agents/digital-marketing/skills/digital-marketing-build-website/scripts/deploy.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/google": "^4.0.56",
    "@ai-sdk/openai": "^4.0.50",
    "@anthropic-ai/sdk": "^0.120.0",
    "@inquirer/prompts": "^8.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.83",
    "commander": "^15.0.0",
    "postgres": "^3.4.5",
    "pptxgenjs-plus": "^4.3.1",
    "puppeteer": "^23.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitepress": "1.6.3"
  },
  "bin": {
    "houselabel": "./engine/cli.ts"
  }
}
